<?xml version="1.0" encoding="utf-8"?>
<!-- Editar datos de contacto y baja lógica (HU03 y M01).
     El empleado ADMIN busca al socio y puede modificar teléfono/email
     o dar de baja con confirmación por AlertDialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".ui.EditarSocioActivity">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ============ Sección de búsqueda ============ -->
            <LinearLayout
                android:id="@+id/llBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoEtiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seccion_buscar" />

                <RadioGroup
                    android:id="@+id/rgCriterio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/rbPorNumero"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbPorNumero"
                        style="@style/OpcionSegmentada"
                        android:layout_marginEnd="6dp"
                        android:text="@string/criterio_numero" />

                    <RadioButton
                        android:id="@+id/rbPorDocumento"
                        style="@style/OpcionSegmentada"
                        android:layout_marginStart="6dp"
                        android:text="@string/criterio_documento" />
                </RadioGroup>

                <EditText
                    android:id="@+id/etNroSocio"
                    style="@style/CampoTexto"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_nro_socio"
                    android:imeOptions="actionSearch"
                    android:inputType="number"
                    android:maxLength="7" />

                <LinearLayout
                    android:id="@+id/llPorDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/spTipoDoc"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_campo"
                        android:popupBackground="@color/superficie" />

                    <EditText
                        android:id="@+id/etNroDoc"
                        style="@style/CampoTexto"
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:hint="@string/hint_nro_doc"
                        android:imeOptions="actionSearch"
                        android:inputType="number"
                        android:maxLength="9" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnBuscar"
                    style="@style/BotonSecundario"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_buscar" />
            </LinearLayout>

            <!-- ============ Formulario (visible solo después de encontrar al socio) ============ -->
            <LinearLayout
                android:id="@+id/llFormulario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Tarjeta con datos del socio encontrado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_tarjeta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSocioNombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/texto"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="GÓMEZ, Andrés" />

                        <TextView
                            android:id="@+id/tvSocioDatos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp"
                            tools:text="Socio N° 1 · DNI 30111222" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEstado"
                        style="@style/Distintivo"
                        tools:text="HABILITADO" />
                </LinearLayout>

                <!-- Datos de contacto editables -->
                <TextView
                    style="@style/TextoEtiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seccion_contacto" />

                <TextView
                    style="@style/TextoCampo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_telefono" />

                <EditText
                    android:id="@+id/etTelefono"
                    style="@style/CampoTexto"
                    android:hint="@string/hint_telefono"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLength="20"
                    tools:text="1144445555" />

                <TextView
                    style="@style/TextoCampo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_email" />

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/CampoTexto"
                    android:hint="@string/hint_email"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:maxLength="100"
                    tools:text="agomez@mail.com" />

                <!-- Botones de acción -->
                <Button
                    android:id="@+id/btnGuardar"
                    style="@style/BotonPrimario"
                    android:layout_marginTop="24dp"
                    android:text="@string/btn_guardar_cambios" />

                <Button
                    android:id="@+id/btnDarDeBaja"
                    style="@style/BotonPeligro"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_dar_de_baja" />

                <Button
                    android:id="@+id/btnCancelar"
                    style="@style/BotonSecundario"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_cancelar" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
