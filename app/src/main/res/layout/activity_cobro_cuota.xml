<?xml version="1.0" encoding="utf-8"?>
<!-- Cobro de cuota (Módulo 2). Se abre de dos formas (Tema II, 8):
     1) desde el botón "Cobro de cuota" del menú: primero se busca al socio;
     2) automáticamente después del alta: el socio ya viene cargado y se cobra la 1ª cuota. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".ui.CobroCuotaActivity">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ============ Búsqueda del socio ============ -->
            <LinearLayout
                android:id="@+id/llBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoEtiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seccion_buscar" />

                <RadioGroup
                    android:id="@+id/rgCriterio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/rbPorNumero"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbPorNumero"
                        style="@style/OpcionSegmentada"
                        android:layout_marginEnd="6dp"
                        android:text="@string/criterio_numero" />

                    <RadioButton
                        android:id="@+id/rbPorDocumento"
                        style="@style/OpcionSegmentada"
                        android:layout_marginStart="6dp"
                        android:text="@string/criterio_documento" />
                </RadioGroup>

                <EditText
                    android:id="@+id/etNroSocio"
                    style="@style/CampoTexto"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_nro_socio"
                    android:imeOptions="actionSearch"
                    android:inputType="number"
                    android:maxLength="7" />

                <LinearLayout
                    android:id="@+id/llPorDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/spTipoDoc"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_campo"
                        android:entries="@array/tipos_documento"
                        android:popupBackground="@color/superficie" />

                    <EditText
                        android:id="@+id/etNroDoc"
                        style="@style/CampoTexto"
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:hint="@string/hint_nro_doc"
                        android:imeOptions="actionSearch"
                        android:inputType="number"
                        android:maxLength="9" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnBuscar"
                    style="@style/BotonSecundario"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_buscar" />
            </LinearLayout>

            <!-- ============ Datos del socio y del cobro (visibles cuando hay un socio) ============ -->
            <LinearLayout
                android:id="@+id/llCobro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_tarjeta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSocioNombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/texto"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="SOSA, Julio" />

                        <TextView
                            android:id="@+id/tvSocioDatos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp"
                            tools:text="Socio #6 · DNI 29555666" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEstado"
                        style="@style/Distintivo"
                        tools:text="INHABILITADO" />
                </LinearLayout>

                <!-- Verificación de la cuota: vencida, al día o primera cuota -->
                <TextView
                    android:id="@+id/tvAvisoCuota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="12dp"
                    android:textSize="13sp"
                    tools:text="Cuota vencida el 13/09/2026 · 14 días de atraso" />

                <TextView
                    style="@style/TextoEtiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seccion_importe" />

                <EditText
                    android:id="@+id/etMonto"
                    style="@style/CampoTexto"
                    android:layout_height="64dp"
                   android:fontFamily="@font/montserrat_black"
                    android:inputType="numberDecimal"
                    android:maxLength="9"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="18000" />

                <TextView
                    style="@style/TextoAyuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ayuda_importe" />

                <TextView
                    style="@style/TextoEtiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seccion_forma_pago" />

                <RadioGroup
                    android:id="@+id/rgFormaPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/rbEfectivo"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbEfectivo"
                        style="@style/OpcionSegmentada"
                        android:layout_marginEnd="6dp"
                        android:text="@string/pago_efectivo" />

                    <RadioButton
                        android:id="@+id/rbTarjeta"
                        style="@style/OpcionSegmentada"
                        android:layout_marginStart="6dp"
                        android:text="@string/pago_tarjeta" />
                </RadioGroup>

                <TextView
                    style="@style/TextoEtiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seccion_cuotas" />

                <RadioGroup
                    android:id="@+id/rgCuotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/rbCuotas1"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbCuotas1"
                        style="@style/OpcionSegmentada"
                        android:layout_marginEnd="6dp"
                        android:text="1" />

                    <RadioButton
                        android:id="@+id/rbCuotas3"
                        style="@style/OpcionSegmentada"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:text="3" />

                    <RadioButton
                        android:id="@+id/rbCuotas6"
                        style="@style/OpcionSegmentada"
                        android:layout_marginStart="6dp"
                        android:text="6" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvAvisoCuotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/aviso_cuotas"
                    android:textColor="@color/estado_pendiente"
                    android:textSize="12sp" />

                <!-- Resumen del período que cubre el pago -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_tarjeta"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/lbl_venc_actual"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvVencActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/texto"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="13/09/2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/lbl_nuevo_venc"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvNuevoVenc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/estado_habilitado"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="27/10/2026" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnRegistrarPago"
                    style="@style/BotonPrimario"
                    android:layout_marginTop="24dp"
                    android:text="@string/btn_registrar_pago" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
