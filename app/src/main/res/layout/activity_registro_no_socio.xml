<?xml version="1.0" encoding="utf-8"?>
<!-- Registro de visita de no socio (HU09).
     Permite registrar la visita y el cobro de una persona que no es socio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".ui.RegistroNoSocioActivity">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ============ Datos del visitante ============ -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seccion_visitante" />

            <TextView
                style="@style/TextoCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_tipo_doc" />

            <Spinner
                android:id="@+id/spTipoDoc"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_campo"
                android:popupBackground="@color/superficie" />

            <TextView
                style="@style/TextoCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_nro_doc" />

            <EditText
                android:id="@+id/etNroDoc"
                style="@style/CampoTexto"
                android:hint="@string/hint_nro_doc"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="9" />

            <TextView
                android:id="@+id/tvInfoDoc"
                style="@style/TextoAyuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                tools:text="✓ Registrado/a en la base: LOPEZ, Martin"
                tools:visibility="visible" />

            <TextView
                style="@style/TextoCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_apellido" />

            <EditText
                android:id="@+id/etApellido"
                style="@style/CampoTexto"
                android:hint="@string/hint_apellido"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="60" />

            <TextView
                style="@style/TextoCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_nombre" />

            <EditText
                android:id="@+id/etNombre"
                style="@style/CampoTexto"
                android:hint="@string/hint_nombre"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="60" />

            <!-- ============ Actividad y cobro ============ -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seccion_actividad" />

            <TextView
                style="@style/TextoCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_actividad" />

            <Spinner
                android:id="@+id/spActividad"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_campo"
                android:popupBackground="@color/superficie" />

            <TextView
                style="@style/TextoCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_monto_visita" />

            <EditText
                android:id="@+id/etMonto"
                style="@style/CampoTexto"
                android:layout_height="64dp"
                android:fontFamily="@font/montserrat_black"
                android:hint="0"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLength="9"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="3500" />

            <TextView
                android:id="@+id/tvAyudaMonto"
                style="@style/TextoAyuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Precio de cartilla: $3.500,00 por día" />

            <!-- Botones -->
            <Button
                android:id="@+id/btnRegistrarVisita"
                style="@style/BotonPrimario"
                android:layout_marginTop="24dp"
                android:text="@string/btn_registrar_visita" />

            <Button
                android:id="@+id/btnCancelar"
                style="@style/BotonSecundario"
                android:layout_marginTop="10dp"
                android:text="@string/btn_cancelar" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
