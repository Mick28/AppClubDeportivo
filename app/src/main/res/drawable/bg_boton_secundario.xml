<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/superficie_alta" /><stroke android:width="1dp" android:color="@color/texto_secundario" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /><stroke android:width="1dp" android:color="@color/borde" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
