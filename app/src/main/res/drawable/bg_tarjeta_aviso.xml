<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de vencimientos del día: franja ámbar a la izquierda, como en el prototipo de Figma. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/superficie" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:width="4dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle"><solid android:color="@color/estado_pendiente" /><corners android:topLeftRadius="8dp" android:bottomLeftRadius="8dp" /></shape>
    </item>
</layer-list>
