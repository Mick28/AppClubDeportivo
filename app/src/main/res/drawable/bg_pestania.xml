<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/fondo" /></shape></item>
            <item android:gravity="bottom|fill_horizontal" android:height="2dp">
                <shape android:shape="rectangle"><solid android:color="@color/primario" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/fondo" /></shape></item>
            <item android:gravity="bottom|fill_horizontal" android:height="1dp">
                <shape android:shape="rectangle"><solid android:color="@color/borde" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
