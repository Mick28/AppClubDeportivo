<?xml version="1.0" encoding="utf-8"?>
<!-- El campo enfocado se marca con borde amarillo: único uso del color primario fuera de los botones (1ª entrega, 3.2). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/superficie" /><stroke android:width="2dp" android:color="@color/primario" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/superficie" /><stroke android:width="1dp" android:color="@color/borde" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
